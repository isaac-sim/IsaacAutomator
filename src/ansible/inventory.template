# template for ansible inventory file

[targets:vars]
cloud="{cloud}"
in_china={in_china}
ssh_port={ssh_port}
ansible_user="{config[default_ssh_user]}"
vnc_password="{vnc_password}"
deployment_name="{deployment_name}"
isaaclab_git_checkpoint="{isaaclab}"
isaacsim_git_checkpoint="{isaacsim}"
isaaclab_private_git="{isaaclab_private_git}"
system_user_password="{system_user_password}"
isaaclab_arena_git_checkpoint="{isaaclab_arena}"
isaacsim_git_repo="{isaacsim_git_repo}"
isaaclab_git_repo="{isaaclab_git_repo}"
isaaclab_arena_git_repo="{isaaclab_arena_git_repo}"
demos="{demos}"
uploads_dir="{config[default_remote_uploads_dir]}"
results_dir="{config[default_remote_results_dir]}"
workspace_dir="{config[default_remote_workspace_dir]}"
generic_driver_apt_package="{config[generic_driver_apt_package]}"
ansible_ssh_private_key_file="{config[state_dir]}/{deployment_name}/key.pem"

[targets:children]
isaac_workstation

[isaac_workstation]
{isaac_workstation_ip}

